{
  "expo": {
    "name": "FACILYTRON",
    "slug": "cafm-mobile-frontend",
    "icon": "./assets/images/logo_withoutBG.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cafmmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.computeraidedfacilitymanagement"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_withoutBG.png",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.computeraidedfacilitymanagement"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FACILYTRON to access your camera to scan QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb13dad3-3b33-4bb1-9b01-c725a2b9eea7"
      }
    }
  }
}